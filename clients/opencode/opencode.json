{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b-instruct-q4_K_M": {
          "name": "Qwen2.5-Coder 3B — agente rapido (default)"
        },
        "qwen2.5-coder:1.5b-instruct-q4_K_M": {
          "name": "Qwen2.5-Coder 1.5B — ultra rapido, calidad limitada"
        },
        "llama3.2:3b-instruct-q4_K_M": {
          "name": "Llama 3.2 3B — alternativa otra familia"
        },
        "llama3.1:8b-instruct-q4_K_M": {
          "name": "Llama 3.1 8B — fallback medio con tools"
        },
        "qwen3-coder:30b": {
          "name": "Qwen3-Coder 30B-A3B MoE — calidad alta, NO interactivo en CPU"
        }
      }
    }
  },
  "model": "ollama-local/qwen2.5-coder:3b-instruct-q4_K_M",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/clp/Workspace"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["uvx", "mcp-server-git"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": false
    },
    "time": {
      "type": "local",
      "command": ["uvx", "mcp-server-time", "--local-timezone", "Atlantic/Canary"],
      "enabled": false
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": false
    },
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-kubernetes"],
      "enabled": true,
      "environment": {
        "KUBECONFIG": "/home/clp/.kube/config"
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "orasql": {
      "type": "local",
      "command": ["uv", "run", "--project", "/home/clp/Workspace/orasql", "orasql", "mcp", "serve"],
      "enabled": true,
      "environment": {
        "ORACLE__USER": "{env:ORACLE_USER}",
        "ORACLE__PASSWORD": "{env:ORACLE_PASSWORD}",
        "ORACLE__DSN": "{env:ORACLE_DSN}",
        "ORASQL_MCP_ALLOWED_DSNS": "{env:ORASQL_MCP_ALLOWED_DSNS}"
      }
    },

    "gitlab": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-gitlab"],
      "enabled": false,
      "environment": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_TOKEN}",
        "GITLAB_API_URL": "{env:GITLAB_API_URL}"
      }
    },
    "mermaid": {
      "type": "local",
      "command": ["npx", "-y", "mcp-mermaid"],
      "enabled": false
    },
    "plantuml": {
      "type": "local",
      "command": ["npx", "-y", "@antoinebou12/uml-mcp"],
      "enabled": false
    }
  },
  "instructions": [
    "Eres un agente de desarrollo trabajando en el workspace MutuaTFE 2.0.",
    "Convenciones globales en /home/clp/Workspace/CLAUDE.md y luz/claude-config/rules/convenciones.md.",
    "PL/SQL: ISO-8859-15 sin acentos en .sql, NUNCA editar con Write/Edit (corrompe encoding), usar LC_ALL=C sed -i o perl -pi -e.",
    "Python: 3.13+, type hints obligatorios, msgspec Struct sobre Pydantic, asyncio.TaskGroup sobre gather, stlog en bash (no print/echo/colores).",
    "TypeScript: React-Admin 5 + MUI 7, strict mode, inputs size='small', dialogs CSS Grid 2 cols, semantic tokens MUI (nunca hex directo).",
    "ORDS: handlers minimos (SELECT+WHERE+ORDER BY+COUNT OVER), JOINs de enriquecimiento en handlers NO en vistas.",
    "Documentacion en luz (MkDocs Material): PlantUML para diagramas C4/arquitectura, Mermaid para flujos simples, admonitions !!! tip/note/warning, acentos correctos UTF-8.",
    "Commits: Conventional Commits en espanol imperativo (anadir/corregir/actualizar), scopes por proyecto, NUNCA Co-Authored-By Claude.",
    "MCPs disponibles: filesystem, git, fetch, time, sequential-thinking, memory, kubernetes, github, orasql (Oracle CBO lint + explain + analyze + describe + query, http://127.0.0.1:8765/mcp).",
    "Antes de ejecutar comandos destructivos (rm, drop, force-push), pedir confirmacion."
  ]
}
